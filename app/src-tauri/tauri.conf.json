{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Way",
  "version": "0.1.0",
  "identifier": "io.github.johnnnytang.photoway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Photo Way", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 560, "dragDropEnabled": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Photography",
    "publisher": "Photo Way contributors",
    "copyright": "Copyright (c) Photo Way contributors. MIT licensed; uses libheif and libde265 (LGPL-3.0).",
    "shortDescription": "Turn geotagged photos into a portable route map",
    "longDescription": "Photo Way turns a folder of geotagged photos and videos into a self-contained route map you can open in any browser.",
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
